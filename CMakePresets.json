{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 22,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "waveshare86",
      "displayName": "Waveshare ESP32-P4-86-Panel-ETH-2RO",
      "generator": "Ninja",
      "binaryDir": "build/waveshare86",
      "environment": {
        "MY_BOARD": "waveshare86"
      },
      "cacheVariables": {
        "SDKCONFIG": "build/waveshare86/sdkconfig",
        "SDKCONFIG_DEFAULTS": "sdkconfig.defaults;sdkconfig.waveshare86"
      }
    },
    {
      "name": "tab5",
      "displayName": "M5Stack TAB5",
      "generator": "Ninja",
      "binaryDir": "build/tab5",
      "environment": {
        "MY_BOARD": "tab5"
      },
      "cacheVariables": {
        "SDKCONFIG": "build/tab5/sdkconfig",
        "SDKCONFIG_DEFAULTS": "sdkconfig.defaults;sdkconfig.tab5"
      }
    },
    {
      "name": "waveshare185c",
      "displayName": "Waveshare ESP32-S3-Touch-LCD-1.85C",
      "generator": "Ninja",
      "binaryDir": "build/waveshare185c",
      "environment": {
        "MY_BOARD": "waveshare185c"
      },
      "cacheVariables": {
        "SDKCONFIG": "build/waveshare185c/sdkconfig",
        "SDKCONFIG_DEFAULTS": "sdkconfig.defaults;sdkconfig.waveshare185c"
      }
    },
    {
      "name": "esp32_4848s040",
      "displayName": "GUITION ESP32-4848S040 (speaker)",
      "generator": "Ninja",
      "binaryDir": "build/esp32_4848s040",
      "environment": {
        "MY_BOARD": "esp32_4848s040"
      },
      "cacheVariables": {
        "SDKCONFIG": "build/esp32_4848s040/sdkconfig",
        "SDKCONFIG_DEFAULTS": "sdkconfig.defaults;sdkconfig.esp32_4848s040",
        "IDF_TARGET": "esp32s3"
      },
      "vendor": {
        "espressif/vscode-esp-idf": {
          "schemaVersion": 1,
          "settings": [
            {
              "type": "openOCD",
              "value": {
                "debugLevel": 2,
                "configs": [
                  "board/esp32s3-builtin.cfg"
                ],
                "args": []
              }
            }
          ]
        }
      }
    }
  ]
}
