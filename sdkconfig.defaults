# Common application defaults; hardware settings are in sdkconfig.<board>.
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_AUDIO_DECODER_MP3_SUPPORT=y
CONFIG_AUDIO_DECODER_AAC_SUPPORT=y

# Reserve room for the application and the ESP-IDF audio components.
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
