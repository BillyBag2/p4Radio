# GUITION ESP32-4848S040 speaker variant: N16R8, native Wi-Fi, RGB LCD.
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y
# Leave PSRAM for the twenty-second mono PCM queue, media and cached skins.
# Mask the RGB ISR during cache-disabled flash writes: bounce refills read
# PSRAM. Restart at VSYNC afterwards to recover DMA alignment after underrun.
CONFIG_SPIRAM_XIP_FROM_PSRAM=n
CONFIG_SPIRAM_FETCH_INSTRUCTIONS=n
CONFIG_SPIRAM_RODATA=n
CONFIG_LCD_RGB_ISR_IRAM_SAFE=n
CONFIG_LCD_RGB_RESTART_IN_VSYNC=y
CONFIG_ESP32S3_DATA_CACHE_64KB=y
CONFIG_ESP32S3_DATA_CACHE_LINE_64B=y
# Leave SRAM for Wi-Fi, RGB bounce buffers, I2S DMA and audio task stacks.
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y
CONFIG_MBEDTLS_HARDWARE_AES=n
CONFIG_ESP_WIFI_REMOTE_ENABLED=n
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.esp32_4848s040.csv"
# GPIO19/20 are touch/RGB pins, not available for native USB console.
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=n
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y
CONFIG_CODEC_I2C_BACKWARD_COMPATIBLE=n
