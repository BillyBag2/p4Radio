# Waveshare ESP32-P4-86-Panel-ETH-2RO (SKU 31570)

# The P4NRW32 module has 32 MB external SPI NOR flash and 32 MB in-package PSRAM.
CONFIG_ESPTOOLPY_FLASHSIZE_32MB=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_HEX=y
CONFIG_SPIRAM_SPEED_200M=y
# Support ESP32-P4 revision 1.3 (the pre-v3 silicon branch).
CONFIG_ESP32P4_SELECTS_REV_LESS_V3=y
# Rev 1.3 silicon must use the 360 MHz CPU clock profile.
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_360=y

# ESP32-C6 Wi-Fi/Bluetooth coprocessor over the board's SDIO connection.
CONFIG_ESP_HOSTED_ENABLED=y
CONFIG_ESP_WIFI_REMOTE_ENABLED=y
CONFIG_SLAVE_IDF_TARGET_ESP32C6=y
CONFIG_ESP_HOSTED_CP_TARGET_ESP32C6=y
CONFIG_ESP_HOSTED_P4_DEV_BOARD_FUNC_BOARD=y
CONFIG_ESP_HOSTED_MEMPOOL_PREFER_SPIRAM=y

# Pre-v3 P4 silicon cannot use the ECDSA peripheral for TLS verification.
CONFIG_MBEDTLS_HARDWARE_ECDSA_VERIFY=n
